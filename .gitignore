# Keep shared code-agent configuration tracked.
!.codex/config.toml
!.codex/langfuse.example.json
!.claude/settings.json
!.claude/settings.local.example.json

# Per-student, project-local Langfuse credentials and shared archive mode.
.codex/langfuse.json
.claude/settings.local.json
rcore-agent-token*.json

# Ignore the retired policy until setup migrates and removes it.
.agents/session-archive.json

# Local Markdown archives and legacy transcripts. These may contain sensitive data.
.agent-sessions/

# Python bytecode generated by the archive-plugin tests.
__pycache__/
*.py[cod]
