# Keep shared code-agent configuration tracked.
!.codex/config.toml
!.codex/langfuse.example.json
!.claude/settings.json
!.claude/settings.local.example.json

# Per-student, project-local Langfuse credentials.
.codex/langfuse.json
.claude/settings.local.json
rcore-agent-token*.json

# Per-student local archive policy.
.agents/session-archive.json

# Filtered or raw local coding-agent transcripts. These may contain sensitive data.
.agent-sessions/

# Python bytecode generated by the archive-plugin tests.
__pycache__/
*.py[cod]
